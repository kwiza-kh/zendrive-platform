# Docker Compose environment variables
# Copy this file to .env and edit for your deployment.

# Backend
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@zendrive.com
ADMIN_PASSWORD=Zendrive@2026
DATABASE_URL=sqlite:///./db/zendrive.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Frontend build args — set to your server's public URL, or leave empty for same-origin.
# Example: REACT_APP_API_BASE_URL=http://your-server-ip/api
REACT_APP_API_BASE_URL=/api
REACT_APP_STATIC_BASE_URL=
